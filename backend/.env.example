# Create a database in MySQL first, e.g. CREATE DATABASE hr_rag CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://hr_rag_user:CHANGE_ME@127.0.0.1:3306/hr_rag
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
CHROMA_PATH=./chroma_db
DOCUMENTS_PATH=./data
JWT_SECRET=replace-this-with-a-long-random-secret-before-use
ACCESS_TOKEN_MINUTES=60

# Initial demo accounts are created only if the users table is empty.
# Change these before first startup. Use strong passwords.
SEED_ADMIN_USERNAME=hradmin
SEED_ADMIN_PASSWORD=ChangeThisAdmin123!
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD=ChangeThisEmployee123!
